// .vscode/launch.json
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Install Dependencies",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm install",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run and Debug App",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Dev Server"
    },
    {
      "name": "Build for Production",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
